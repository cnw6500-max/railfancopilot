<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (android:dataExtractionRules).
    Controls both cloud backup and device-to-device transfer.
    Excludes sensitive data to prevent location history, photo metadata, and
    API-derived data from leaving the device without the user's knowledge.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="photos" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="photos" />
    </device-transfer>
</data-extraction-rules>
