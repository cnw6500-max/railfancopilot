rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Community sightings — readable by all, writable only with valid data
    match /sightings/{sightingId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
                        'railroad', 'trainSymbol', 'location', 'notes',
                        'latitude', 'longitude', 'reporterName',
                        'timestampMs', 'upvotes'
                      ])
                    && request.resource.data.latitude is number
                    && request.resource.data.longitude is number
                    && request.resource.data.latitude >= -90
                    && request.resource.data.latitude <= 90
                    && request.resource.data.longitude >= -180
                    && request.resource.data.longitude <= 180
                    && request.resource.data.upvotes == 0
                    && request.resource.data.notes is string
                    && request.resource.data.notes.size() <= 1000
                    && request.resource.data.reporterName is string
                    && request.resource.data.reporterName.size() <= 100;

      // Only allow upvote increments (no other field changes)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
                    && request.resource.data.upvotes == resource.data.upvotes + 1;

      // No client-side deletes
      allow delete: if false;
    }

    // Community railfan spots — readable by all, writable by authenticated users
    match /railfan_spots/{spotId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['name', 'latitude', 'longitude', 'submittedBy', 'submittedMs'])
                    && request.resource.data.latitude is number
                    && request.resource.data.longitude is number
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'photoUrls'])
                    && request.resource.data.upvotes == resource.data.upvotes + 1
                       || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrls']);
      allow delete: if false;
    }

    // Per-user data — FCM token + watchlist. Each user can only access their own doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /watchlist/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Comments on sightings — any authenticated user can read/write
    match /sightings/{sightingId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['userName', 'text', 'timestampMs'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;
      allow delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
